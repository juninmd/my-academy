{
  "name": "my-academy-api",
  "version": "0.0.1",
  "description": "A Academia fácil",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "DATABASE_URL=postgresql://build:build@localhost:5432/build prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:db": "E2E_DATABASE_URL=postgresql://academy:academy@localhost:5433/myacademy E2E_REDIS_URL=redis://localhost:6380 vitest run --config vitest.e2e.config.ts test/personas.e2e-spec.ts",
    "prisma:generate": "DATABASE_URL=postgresql://build:build@localhost:5432/build prisma generate",
    "prisma:push": "prisma db push",
    "prisma:format": "prisma format",
    "prisma:seed": "bun prisma/seed.ts && bun prisma/seed-homologation.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@keyv/redis": "5.1.6",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/nestjs-api-reference": "^1.2.19",
    "axios": "^1.18.1",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.4.0",
    "keyv": "^5.6.0",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "bun@1.4.2",
  "type": "module",
  "overrides": {
    "mysql2": "3.24.4",
    "uuid": "11.1.1"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "@swc/core"
  ]
}
