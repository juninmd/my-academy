# HTTP port (default 9000)
PORT=9000

# Redis cache (optional — when unset, an in-memory cache is used)
REDIS_URL=

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/myacademy?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/myacademy?schema=public"

# Firebase Auth
FIREBASE_ENABLED=true
SA_TYPE="service_account"
SA_PROJECT_ID=""
SA_PRIVATE_KEY_ID=""
SA_PRIVATE_KEY=""
SA_CLIENT_EMAIL=""
SA_CLIENT_ID=""
SA_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
SA_TOKEN_URI="https://oauth2.googleapis.com/token"
SA_AUTH_PROVIDER="https://www.googleapis.com/oauth2/v1/certs"
SA_CLIENT_X509=""

# CORS — comma-separated list of allowed origins
# Example: https://myapp.com,https://www.myapp.com
CORS_ORIGINS=""

# Telegram bot
TELEGRAM_TOKEN=""

# Seed: real owner account (optional; defaults to an example user)
SEED_OWNER_UID=""
SEED_OWNER_EMAIL=""
SEED_OWNER_NAME=""

# Mock auth (development only — NEVER enable in production)
AUTH_MOC_ENABLED=false
AUTH_MOC_TOKEN=
AUTH_MOC_JSON=
